# ============================================================
# ON-GROUND.AI CALL CENTER APP - ENVIRONMENT CONFIGURATION
# ============================================================

# Backend Port & Frontend API target
PORT=3001
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------
# 1. LIVEKIT WEBRTC REAL CALLING (RECOMMENDED - 100% FREE)
# ------------------------------------------------------------
# - Free signup at https://livekit.io (50 GB free bandwidth/month, no credit card)
# - Or leave blank to use the built-in local WebRTC peer gateway!
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------
# 2. TWILIO PSTN TELEPHONY ADAPTER (OPTIONAL PSTN)
# ------------------------------------------------------------
# - Signup at https://www.twilio.com ($15 trial credit)
# - Account SID and Auth Token found on Twilio Console Dashboard
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12025550199

# The Agent's direct phone number (used in human-to-human PSTN bridge)
AGENT_PHONE_NUMBER=+12025550143

# Public webhook base URL (required for Twilio carrier callbacks, e.g. using ngrok)
TWILIO_WEBHOOK_BASE_URL=http://localhost:3001

# ------------------------------------------------------------
# 3. CONVERSATIONAL VOICE AI INTELLIGENCE
# ------------------------------------------------------------
# Optional: Set OPENAI_API_KEY to use GPT-4o-mini for natural language phrasing.
# If left blank, the app uses its built-in zero-cost grounded deterministic sales engine!
OPENAI_API_KEY=

# ------------------------------------------------------------
# 4. DESTINATION NUMBERS & INDIA (+91) GUIDELINES
# ------------------------------------------------------------
# - Twilio Trial accounts can dial any verified phone number for free.
# - To test calling an Indian mobile number (+91):
#   1. Go to Twilio Console -> Phone Numbers -> Manage -> Verified Caller IDs
#   2. Add your phone number and enter the 6-digit verification code.
