# ============================================================
# ON-GROUND.AI CALL CENTER APP - ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port
PORT=3001
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------
# TWILIO REAL CALLING CONFIGURATION (Human-to-Human Calling)
# ------------------------------------------------------------
# 1. Sign up at https://www.twilio.com
# 2. Retrieve your Account SID and Auth Token from Twilio Console
# 3. Buy/configure a Twilio Phone Number capable of Voice
# 4. In development trial, ensure destination numbers are verified
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12025550199

# The Agent's direct phone number to bridge the call to (e.g. your personal mobile phone)
# When you click "Call Lead", Twilio calls your phone first, then dials the customer lead
AGENT_PHONE_NUMBER=+12025550143

# Public webhook base URL (required for Twilio callbacks, e.g. using ngrok or deployed server)
# e.g., https://your-domain.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=http://localhost:3001

# ------------------------------------------------------------
# AI-TO-HUMAN VOICE CALLING CONFIGURATION (Optional Voice AI)
# ------------------------------------------------------------
# Set provider: 'twilio-twiml' | 'openai-realtime' | 'simulator'
VOICE_AI_PROVIDER=simulator
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
